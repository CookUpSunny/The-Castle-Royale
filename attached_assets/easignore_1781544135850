# EAS upload excludes — trims the ~1.3 GB archive to ~100 MB.
# None of these are needed to install dependencies or compile/bundle the iOS app.
# This only affects what gets uploaded to EAS; it does NOT touch git or your repo.

# Replit scratch dumps — screenshots, audio, generated media (~660 MB)
attached_assets/

# Git history — committed binaries (~530 MB). EAS doesn't need it in the file archive.
.git/

# Backend server — the app talks to it at runtime over sockets; its source is never bundled into the IPA
artifacts/api-server/

# Mockups / sandbox previews
artifacts/mockup-sandbox/

# Stray preview file
artifacts/mobile/sfx-alternatives-preview.html

.DS_Store
