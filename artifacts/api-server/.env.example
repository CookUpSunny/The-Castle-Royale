# Required for the API process. Not read by the mobile app.
DATABASE_URL=

# Full Authorization header value configured on the RevenueCat webhook.
# Example: Bearer <secret generated in the RevenueCat dashboard>
# The webhook stays closed until this is set.
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Dev only. Google's test rewarded ads cannot call your SSV URL.
# Set to true on a development server to let those test ads grant Second Chance.
# Leave unset in production so only AdMob Server-Side Verification can grant it.
ADMOB_ALLOW_UNVERIFIED_REWARDS=

# Game Center identity checks. The default is the live App Store bundle id
# (app.replit.thecastleroyale, Apple ID 6772010192). Set this only to override it.
GC_BUNDLE_ID=
