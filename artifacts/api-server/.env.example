# Required for the API process. Not read by the mobile app.
DATABASE_URL=

# Full Authorization header value configured on the RevenueCat webhook.
# Example: Bearer <secret generated in the RevenueCat dashboard>
# The webhook stays closed until this is set.
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Dev only. Google's test rewarded units cannot call the SSV URL.
# Set to true on a development server so those test ads can grant Second Chance.
ADMOB_ALLOW_UNVERIFIED_REWARDS=

# Leave unset until the rewarded unit's Server-Side Verification callback is saved.
# Callback URL to paste in AdMob, with no query string of your own:
# https://The-castle-royale.replit.app/api/ads/ssv
# Until this is true, POST /api/ads/second-chance/:offerId/fallback-grant can
# confirm the one pending tournament offer. Set this to true after SSV is live
# so only AdMob's signed callback can grant it.
ADMOB_SSV_ENABLED=

# Game Center identity checks. The default is the live App Store bundle id
# (app.replit.thecastleroyale, Apple ID 6772010192). Set this only to override it.
GC_BUNDLE_ID=
