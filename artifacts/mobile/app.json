{
  "expo": {
    "name": "The Castle Royale",
    "slug": "thecastleroyale",
    "entryPoint": "index.js",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "thecastleroyale",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/castle-royale-splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": false,
      "bundleIdentifier": "app.replit.thecastleroyale",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": false,
        "NSAppleMusicUsageDescription": "Castle Royale streams arena songs from Apple Music so the artist is paid for the play. Apple Music is optional. Built-in music plays if you decline or cannot stream.",
        "NSUserTrackingUsageDescription": "Castle Royale uses this identifier to show ads to free players. High Roller and VIP members do not see forced ads."
      }
    },
    "android": {
      "package": "app.replit.thecastleroyale",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#07000f"
      }
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#a855f7"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/castle-royale-splash-logo.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "00ffd88a-a639-4296-b59f-7ff224e87548"
      }
    },
    "owner": "krazi"
  }
}
