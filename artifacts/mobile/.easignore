# Project-directory ignore. eas-cli archives from the git root and applies the
# root .easignore (see eas-cli GitClient.getRootPathAsync). This file still
# excludes a native project if a tool copies only artifacts/mobile.

# Locally-generated native projects.
# ios/ and android/ are created by `expo prebuild` on the developer's machine and
# contain absolute paths like /Users/<name>/... that break EAS Linux build servers.
# Excluding them forces EAS to run a clean `expo prebuild` on every build.
ios/
android/

# Expo + Metro caches
.expo/
dist/
node_modules/

# macOS noise
.DS_Store
