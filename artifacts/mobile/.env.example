# Server domain — no https:// prefix, no trailing slash.
# Dev/Expo Go: use your Replit dev domain (riker.replit.dev URL)
# Production EAS build: use your deployed Replit domain (e.g. thecastleroyale.replit.app)
EXPO_PUBLIC_DOMAIN=your-domain-here.riker.replit.dev

# RevenueCat public SDK keys. Do not commit the values.
# The owner sets EXPO_PUBLIC_REVENUECAT_IOS_KEY as an EAS environment variable.
# An iOS build needs that key. The test key is used in Expo Go / dev when set.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# AdMob. The iOS App ID is in app.config.js (ca-app-pub-2426597243989008~4741781660).
# Dev and internal builds use Google's test ad units. Production and TestFlight
# use the committed iOS units unless one of the overrides below is set.
# EXPO_PUBLIC_ADMOB_USE_TEST_UNITS=true forces test units in an internal EAS build.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
# Leave unset until AdMob SSV is saved. true makes the app wait for the callback
# instead of the temporary server fallback.
EXPO_PUBLIC_ADMOB_SSV_ENABLED=
