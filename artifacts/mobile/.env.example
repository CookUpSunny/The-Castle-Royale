# Server domain — no https:// prefix, no trailing slash.
# Dev/Expo Go: use your Replit dev domain (riker.replit.dev URL)
# Production EAS build: use your deployed Replit domain (e.g. thecastleroyale.replit.app)
EXPO_PUBLIC_DOMAIN=your-domain-here.riker.replit.dev

# RevenueCat public SDK keys. An iOS build only needs the iOS key.
# The test key is used in Expo Go / dev when set; otherwise the iOS key is used.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=

# AdMob. The iOS App ID is already in app.config.js (ca-app-pub-2426597243989008~4741781660).
# Set EXPO_PUBLIC_ADMOB_IOS_APP_ID only to override it.
# There are no live ad units yet. Leave the unit IDs blank to keep Google's test units.
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
